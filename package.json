{
  "name": "web-tvbox",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "tv": "node scripts/tv.mjs",
    "test:deploy": "node --test scripts/tv/*.test.mjs",
    "test:production-build": "node scripts/test-production-build.mjs",
    "test:production-install": "node scripts/test-production-build.mjs --start",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "DBTV_DEV_WATCH=1 tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "node scripts/release-build.mjs stamp && npm run db:generate && tsc -p server/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "sh scripts/start.sh",
    "setup": "node scripts/setup-database.mjs",
    "test": "node --import tsx --test server/tests/*.test.ts client/tests/*.test.ts",
    "test:database": "npm run build && node --test server/tests/*integration.mjs",
    "db:generate": "node scripts/database.mjs generate",
    "db:validate": "node scripts/database.mjs validate",
    "db:push": "node scripts/database.mjs push",
    "db:seed": "node scripts/seed.mjs",
    "postinstall": "node scripts/database.mjs generate",
    "lint": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.13.0",
    "@websr/websr": "0.0.16",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "hls.js": "^1.6.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@webgpu/types": "0.1.34",
    "concurrently": "^9.2.0",
    "prisma": "6.13.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
