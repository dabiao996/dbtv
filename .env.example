NODE_ENV=production
# sqlite | mysql | postgresql；也可执行 npm run setup 交互选择。
DATABASE_PROVIDER=sqlite
# SQLite 相对路径以 prisma/ 为基准；此路径也对应 Docker 持久卷 /app/data。
# 旧部署 file:./dev.db 继续使用原来的 prisma/dev.db，不会自动迁移。
DATABASE_URL="file:../data/dabiao.db"
# MySQL 示例：mysql://dabiao:URL_ENCODED_PASSWORD@127.0.0.1:3306/dabiao
# PostgreSQL 示例：postgresql://dabiao:URL_ENCODED_PASSWORD@127.0.0.1:5432/dabiao?schema=public
# 保留旧版启动时同步表结构；不会强制清库或接受数据丢失。生产升级先备份。
# 设为 false 时先手动执行 npm run db:push 或已审核的数据库迁移。
DB_AUTO_SYNC=true
# 网页首次安装的连接配置、安装锁及令牌存放处；留空使用项目 data/，容器固定 /app/data。
# 网页安装完成后，私有 database.json 优先于这里的 DATABASE_*；升级须保留并备份该目录。
DBTV_DATA_DIR=""
# 可选安装令牌（至少32位）；留空会自动生成，并在首次启动日志中提示。不要提交真实令牌。
INSTALL_TOKEN=""
# 一键管理脚本设为false，避免安装令牌进入服务日志；手动部署默认仍在首次日志提示。
INSTALL_TOKEN_LOG=true
# Docker 对外端口和地址（容器内部仍为8787）。面板反代默认只监听本机。
DBTV_PORT=8787
DBTV_BIND_IP=127.0.0.1
PORT=8787
HOST="0.0.0.0"
# 若前端使用独立域名，填精确来源，例如 https://tv.example.com；默认仅接受同源请求。
APP_ORIGIN=""
# HTTPS 反向代理部署设为 true；本地 HTTP 测试保持 false。
COOKIE_SECURE=false
# 可选：TMDB API Read Access Token，仅供服务器使用。也可在后台「网站设置 → 影片评分」填写。
# 不要添加 VITE_ 前缀，不要提交真实令牌。
TMDB_READ_ACCESS_TOKEN=""
# 可选 AI 找片 / 对话推荐。只在服务器端配置；不设置时网页显示未配置，普通搜索正常可用。
# 用户输入的对话和已保存的题材偏好会发送到 OpenAI；不会发送观看历史或账号资料。
DBTV_AI_API_KEY=""
DBTV_AI_MODEL=""
# 只用于本地初始化提示，不要提交真实密码或密钥。
# 管理员账号和密码请通过首次 /install 向导创建。
